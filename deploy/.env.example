# Banco
DB_NAME=desphub
DB_USER=postgres
DB_PASSWORD=troque-esta-senha

# Deve ser IGUAL ao SESSION_TOKEN_APIKEY do compose do RPA (deploy/.env do RPA).
SESSION_TOKEN_APIKEY=troque-esta-chave

# Segredos da aplicação (gere valores fortes e únicos em produção).
JWT_SECRET=troque-por-uma-chave-hex-de-64-caracteres
JWT_EXPIRATION_MINUTES=480
JWT_PAIRING_EXPIRATION_MINUTES=5
CRYPTO_SECRET=troque-este-segredo
CRYPTO_SALT=troque-este-salt

# Origens do front em produção (+ extensão). Separe por vírgula.
CORS_ALLOWED_ORIGINS=https://app.desphub.com,chrome-extension://*

# Porta publicada do backend no host (edge). Ver nota no compose sobre TLS.
BACKEND_PORT=8080

# JVM (opcional)
JAVA_OPTS=-XX:MaxRAMPercentage=75
